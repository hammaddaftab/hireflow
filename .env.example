# Fields that don't have ={value} needs to be explicitly set in .env to make the app work

# ──── Database Configuration (Default Fallback Provided) ────
DATABASE_URL=postgresql://postgres:12345@localhost:5432/airecruiter

# ──── Security & Authentication ────
SECRET_KEY=mysecretkey
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ──── CORS Allowed Origins ────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ──── Candidate-facing links ────
FRONTEND_BASE_URL=http://localhost:3000

# ──── AI & LLM Configuration (Default Fallback Provided) ────
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
GOOGLE_MODEL=gemini-2.0-flash

# ──── Mandatory AI Integrations (No Fallback) ────
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ──── Storage & Vercel Blob Integration (Fallback: storage://resumes/{filename}) ────
BLOB_READ_WRITE_TOKEN=

# ──── Ingestion & Testing ────
DISABLE_EMAIL_DEDUP=true
